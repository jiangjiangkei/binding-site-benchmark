.DS_Store
__pycache__/
*.py[cod]

# Local environments and caches.
.venv/
.venv-*/
.pytest_cache/

# Generated benchmark outputs.
results/

# Local benchmark data snapshots and generated artifacts.
data/raw/
data/manifests/*.csv
data/splits/*.ds

# Runtime assets should live outside git, usually under
# ~/.cache/protcross/assets/v0.1.2.
data/assets/

# Explicit data-file exclusions for future benchmark drops.
data/**/*.csv
data/**/*.ds
data/**/*.fasta
data/**/*.fa
data/**/*.jsonl
data/**/*.mmcif
data/**/*.pdb
data/**/*.sdf
data/**/*.tsv
